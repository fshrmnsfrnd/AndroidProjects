<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/lblStrasse2"
        android:layout_width="374dp"
        android:layout_height="31dp"
        android:layout_marginTop="16dp"
        android:text="Postleitzahl und Ort"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtStrasse" />

    <EditText
        android:id="@+id/txtOrt"
        android:layout_width="375dp"
        android:layout_height="43dp"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:text="81245 München"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblStrasse2" />

    <TextView
        android:id="@+id/lblStartMap"
        android:layout_width="377dp"
        android:layout_height="36dp"
        android:layout_marginTop="36dp"
        android:text="Position anzeigen"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/lblStrasse"
        android:layout_width="374dp"
        android:layout_height="31dp"
        android:layout_marginTop="32dp"
        android:text="Strasse"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblStartMap" />

    <EditText
        android:id="@+id/txtStrasse"
        android:layout_width="374dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:gravity="start|top"
        android:inputType="textMultiLine"
        android:text="Bergsonstrasse 109"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblStrasse" />

    <Button
        android:id="@+id/btnShowPos"
        android:layout_width="379dp"
        android:layout_height="44dp"
        android:layout_marginTop="384dp"
        android:onClick="showMap"
        android:text="Position anzeigen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.512"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtStrasse" />
</androidx.constraintlayout.widget.ConstraintLayout>